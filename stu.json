{
  "app": {
    "name": "Project Stu",
    "version": "3.0.0",
    "environment": "local",
    "log_level": "INFO",
    "log_format": "<level>{level: <8}</level> | <cyan>{name}</cyan>:<cyan>{function}</cyan>:<cyan>{line}</cyan> - <level>{message}</level>",
    "log_filename": "stu.log",
    "default_project_id": "default"
  },
  "server": {
    "host": "127.0.0.1",
    "port": 8300,
    "api_prefix": "/api/v1",
    "static_dir": "static",
    "static_mount_path": "/static",
    "cors_enabled": false,
    "cors_origins": []
  },
  "workspace": {
    "root": "workspace",
    "projects_dir": "projects",
    "models_dir": "models",
    "logs_dir": "logs",
    "runtime_dir": "runtime",
    "tmp_dir": "tmp",
    "artifacts_dir": "artifacts",
    "mcp_dir": "mcp",
    "fail_on_symlink_escape": true
  },
  "memory": {
    "l1_max_entries": 1000,
    "project_memory_dir": "memory",
    "project_l2_dir": "l2",
    "project_archive_dir": "archive",
    "project_vectors_dir": "vectors",
    "sqlite_filename": "memory.sqlite3",
    "rag": {
      "enabled": false,
      "top_k": 5
    },
    "embedding": {
      "provider": "sentence-transformers",
      "model": "all-MiniLM-L6-v2",
      "device": "cpu",
      "batch_size": 8
    },
    "lifecycle": {
      "enabled": true,
      "interval_seconds": 300.0,
      "scoring_w_recency": 0.3,
      "scoring_w_frequency": 0.2,
      "scoring_w_importance": 0.3,
      "scoring_w_relevance": 0.2,
      "scoring_decay_half_life_hours": 168.0,
      "decay_episodic_half_life_hours": 72.0,
      "decay_semantic_half_life_hours": 720.0,
      "decay_procedural_half_life_hours": 360.0,
      "decay_reflection_half_life_hours": 1440.0,
      "consolidation_enabled": true,
      "consolidation_min_cluster_size": 3,
      "consolidation_max_per_cycle": 5,
      "archival_enabled": true,
      "archival_score_threshold": 0.15,
      "pruning_enabled": true,
      "pruning_critical_score_threshold": 0.05,
      "pruning_grace_period_hours": 168.0,
      "reflection_enabled": true,
      "reflection_trigger_on_loop_completion": true
    }
  },
  "execution": {
    "loop_state_filename": "loop_state.json",
    "max_iterations": 32,
    "crash_recovery_debounce_seconds": 2.0,
    "phase_timeout_seconds": 300.0
  },
  "tools": {
    "enabled": true,
    "default_timeout_seconds": 60.0,
    "allow_network": false,
    "max_output_bytes": 1048576,
    "write_subdir": "artifacts",
    "core_fallback": [
      "memory_create",
      "memory_search",
      "project_get",
      "system_status"
    ],
    "catalog": [
      {
        "name": "memory_create",
        "description": "Create a project memory entry.",
        "safety_level": "safe",
        "enabled": true
      },
      {
        "name": "memory_search",
        "description": "Search project memory entries.",
        "safety_level": "safe",
        "enabled": true
      },
      {
        "name": "memory_get",
        "description": "Get one project memory entry by ID.",
        "safety_level": "safe",
        "enabled": true
      },
      {
        "name": "project_get",
        "description": "Get metadata for the active project.",
        "safety_level": "safe",
        "enabled": true
      },
      {
        "name": "workspace_list",
        "description": "List files inside the project workspace.",
        "safety_level": "safe",
        "enabled": true
      },
      {
        "name": "workspace_read",
        "description": "Read a text file inside the project workspace.",
        "safety_level": "safe",
        "enabled": true
      },
      {
        "name": "workspace_write",
        "description": "Write a text file into the project artifacts directory.",
        "safety_level": "moderate",
        "enabled": true
      },
      {
        "name": "system_status",
        "description": "Read current system and loop status.",
        "safety_level": "safe",
        "enabled": true
      }
    ],
    "rag": {
      "enabled": false,
      "top_k": 5,
      "vector_subdir": "tools"
    }
  },
  "mcp": {
    "enabled": true,
    "connection_timeout_seconds": 30.0,
    "strict_schema_validation": true,
    "allow_local_stdio": true,
    "allowed_stdio_commands": ["python", "python3", "uvx", "npx"],
    "servers": [
      {
        "name": "mock_server",
        "transport": "mock",
        "enabled": true,
        "tools": [
          {
            "name": "echo",
            "description": "Echoes back the input message",
            "input_schema": {
              "type": "object",
              "properties": {
                "message": {"type": "string", "description": "The message to echo"}
              },
              "required": ["message"]
            }
          },
          {
            "name": "add",
            "description": "Adds two numbers together",
            "input_schema": {
              "type": "object",
              "properties": {
                "a": {"type": "number", "description": "First number"},
                "b": {"type": "number", "description": "Second number"}
              },
              "required": ["a", "b"]
            }
          }
        ]
      }
    ]
  },
  "daemons": {
    "telemetry": {
      "enabled": true,
      "interval_seconds": 3.0,
      "priority": "high"
    },
    "maintenance": {
      "enabled": true,
      "interval_seconds": 900.0,
      "priority": "high"
    },
    "reporting": {
      "enabled": true,
      "interval_seconds": 3600.0,
      "priority": "low"
    }
  },
  "security": {
    "enable_guardrails": true,
    "enable_skill_sanitizer": true,
    "egress_allowlist": [],
    "forbidden_path_patterns": [
      "\\.env",
      "\\.ssh",
      "\\.aws",
      "/etc/",
      "~/"
    ],
    "path_traversal_patterns": [
      "\\.\\./",
      "\\.\\.\\\\",
      "~/",
      "/etc/"
    ],
    "forbidden_argument_patterns": [],
    "shell_command_patterns": [
      ";\\s*rm\\b",
      "&&\\s*rm\\b",
      "\\brm\\s+-rf\\b",
      "\\bcurl\\b",
      "\\bwget\\b"
    ],
    "secret_patterns": [
      "(?i)api[_-]?key\\s*[:=]",
      "(?i)secret\\s*[:=]",
      "sk-[A-Za-z0-9]{16,}"
    ],
    "max_argument_bytes": 200000,
    "max_output_scan_bytes": 200000,
    "event_retention": 500,
    "policy": {
      "fail_loop_on_deny": true,
      "block_on_review": false,
      "record_allow_events": false
    }
  },
  "ui": {
    "default_active_view": "chat",
    "default_nav_collapsed": false,
    "default_telemetry_visible": true,
    "theme": "dark"
  },
  "llm": {
    "provider": "mock",
    "model": "mock-default",
    "rate_limit": {
      "enabled": true,
      "min_interval_seconds": 2.0,
      "max_concurrency": 1,
      "max_queue_wait_seconds": 300.0,
      "fail_on_timeout": false,
      "telemetry_events": true
    }
  },
  "chat": {
    "history_limit": 50,
    "system_prompt": "You are Stu, a helpful and concise AI assistant operating within Project Stu v3.0. You have access to project memory context. Answer clearly and directly."
  }
}
